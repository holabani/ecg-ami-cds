# Copy to backend/.env (same folder as main.py). Never commit `.env`.

# ── Local development: Gmail SMTP (App Password + 2FA) ──────────────────────
# Create app password: https://myaccount.google.com/apppasswords
# Use the same mailbox for USER and inside SMTP_FROM display name.

CARDIOSENSE_EMAIL_MODE=smtp
CARDIOSENSE_SMTP_HOST=smtp.gmail.com
CARDIOSENSE_SMTP_PORT=587
CARDIOSENSE_SMTP_ENCRYPTION=starttls
CARDIOSENSE_SMTP_USER=you@gmail.com
CARDIOSENSE_SMTP_PASSWORD=
CARDIOSENSE_SMTP_FROM=CardioSense <you@gmail.com>

# ── Alternate: OTP only in uvicorn terminal (no network) ─────────────────────
# CARDIOSENSE_EMAIL_MODE=console

# ── Alternate: Resend (HTTPS API) ───────────────────────────────────────────
# CARDIOSENSE_EMAIL_MODE=resend
# CARDIOSENSE_RESEND_API_KEY=re_xxxxx
# CARDIOSENSE_EMAIL_FROM=CardioSense <onboarding@resend.dev>
# If HTTPS to Resend hits SSL verification errors locally only:
# CARDIOSENSE_RESEND_VERIFY_SSL=0
