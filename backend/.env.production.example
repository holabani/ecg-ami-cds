# Backend env for Docker on EC2 (copy to backend/.env — NEVER commit secrets).
#
# Persist SQLite on the named volume cardiosense-backend-data mounted at /data (see docker-compose.production.yml):
CARDIOSENSE_DATABASE_URL=sqlite:////data/cardiosense.db

# REQUIRED for any shared deployment — generate with: openssl rand -hex 32
CARDIOSENSE_SECRET_KEY=

# OTP email (SMTP example) OR use console-only for demos: CARDIOSENSE_EMAIL_MODE=console
CARDIOSENSE_EMAIL_MODE=smtp
CARDIOSENSE_SMTP_HOST=smtp.gmail.com
CARDIOSENSE_SMTP_PORT=587
CARDIOSENSE_SMTP_ENCRYPTION=starttls
CARDIOSENSE_SMTP_USER=
CARDIOSENSE_SMTP_PASSWORD=
CARDIOSENSE_SMTP_FROM=CardioSense <noreply@example.com>

# Optional: download .pt checkpoint on first startup if file not bundled in image
# CARDIOSENSE_CHECKPOINT_URL=https://...

# python-dotenv also loads this file when running uvicorn on host outside Docker
