# Copy to repo root as `.env` (same directory as docker-compose.production.yml).
# Docker Compose substitutes these into the build / services.
#
# REQUIRED: URL the *browser* uses to reach FastAPI (scheme + host + port). No trailing slash.
# Example after DNS: https://api.cardiosense.example.com
# Example raw EC2: http://ec2-1-2-3-4.ap-south-1.compute.amazonaws.com:8000
NEXT_PUBLIC_API_URL=http://REPLACE_WITH_PUBLIC_API_URL:8000

# Grafana (change defaults before any public exposure; compose maps Grafana to 127.0.0.1:3010 by default)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=choose-a-long-random-password
