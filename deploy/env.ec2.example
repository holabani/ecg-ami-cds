# Copy to repo root as `.env` (same directory as docker-compose.production.yml).
# Docker Compose substitutes these into the build / services.
#
# REQUIRED (browser-visible API URL — no trailing slash). After nginx + TLS:
NEXT_PUBLIC_API_URL=https://REPLACE_WITH_API_SUBDOMAIN.example.com
#
# Temporary without nginx (ports published to EC2 SG):
# NEXT_PUBLIC_API_URL=http://REPLACE_WITH_EC2_PUBLIC_IP:8000

# Grafana login + public URL Grafana thinks it serves (HTTPS + subdomain from deploy/nginx/cardiosense-ec2.conf).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=choose-a-long-random-password
GRAFANA_SERVER_ROOT_URL=https://REPLACE_WITH_GRAFANA_SUBDOMAIN.example.com/
