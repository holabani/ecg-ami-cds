{
  "uid": "cardiosense-overview",
  "title": "CardioSense — Overview",
  "description": "ECG CDS monitoring. Traffic: frontend http://localhost:3001 • API POST /predict",
  "tags": ["cardiosense", "ecg"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP requests / sec",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" }
        }
      },
      "options": {
        "legend": { "calcs": ["mean"], "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method, path) (rate(ecg_http_requests_total[2m]))",
          "legendFormat": "{{method}} {{path}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "AMI prediction mix (rates)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": { "stacking": { "mode": "normal", "group": "A" } }
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (binary) (rate(ecg_ami_binary_predictions_total[5m]))",
          "legendFormat": "AMI {{binary}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Predict + ground-truth eval",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ecg_predict_requests_total[2m]))",
          "legendFormat": "Predict calls"
        },
        {
          "refId": "B",
          "expr": "sum(rate(ecg_predict_with_ami_ground_truth_total[2m]))",
          "legendFormat": "Predict w/ GT"
        },
        {
          "refId": "C",
          "expr": "sum by (outcome) (rate(ecg_ami_confusion_vs_ground_truth_total[5m]))",
          "legendFormat": "GT {{outcome}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "HTTP 5xx (total)",
      "gridPos": { "x": 12, "y": 8, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ecg_http_server_errors_total",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "AMI risk tier counts",
      "gridPos": { "x": 18, "y": 8, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tier) (ecg_ami_risk_prediction_total)",
          "legendFormat": "{{tier}}",
          "instant": true
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "/predict latency (seconds, p95)",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, rate(ecg_predict_latency_seconds_bucket[10m]))",
          "legendFormat": "predict p95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(ecg_http_request_duration_seconds_bucket{path=\"/predict\"}[10m])) by (le))",
          "legendFormat": "http /predict p95"
        }
      ]
    }
  ]
}
